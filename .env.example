# HTTP
HTTP_ADDR=:8080

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable

# OIDC / Keycloak
OIDC_ISSUER_URL=http://localhost:8081/realms/wallet
OIDC_CLIENT_ID=wallet-service
OIDC_CLIENT_SECRET=change-me

# AWS SQS / LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_SQS_QUEUE=wager-transactions.fifo
AWS_SQS_DLQ=wager-transactions-dlq.fifo
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Observabilidade
LOG_LEVEL=info